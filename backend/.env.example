# 复制为 .env 并按需修改。数据库/LLM/Ollama 地址在容器内用服务名。
APP_ENV=dev
DEBUG=true

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=campus_platform

# JWT
SECRET_KEY=CHANGE_ME_campus_platform_secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 上传目录
UPLOAD_DIR=uploads
STATIC_URL=/static

# LLM：OpenAI 兼容 API（可指向 Ollama 的 /v1，本地可用）
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# 本地 Ollama（走 ChatOllama 分支）
OLLAMA_HOST=http://localhost:11434

# CORS：逗号分隔的来源列表；生产环境务必改为明确站点，不要用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173