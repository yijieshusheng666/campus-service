# ============================================================
# 后端环境变量模板
#
# 用法：把本文件复制为同目录下的 .env，然后只改下面标注「必改」的 3 处。
#   Windows (cmd/PowerShell):  copy .env.example .env
#   macOS / Linux / Git Bash:  cp .env.example .env
#
# 说明：本文件 .env.example 会被提交到 Git；而 .env 已被 .gitignore 忽略，
#       所以你的密码和 API Key 不会被推上 GitHub。
# ============================================================

# ------------------------------------------------------------
# 【必改 ①】本地 MySQL 连接
# 把 DB_PASSWORD 的值填成你自己 MySQL 的密码（只能填 ASCII 字符，不能含中文），
# 库名保持 campus_platform 即可
# （库需要自己先建，见 README「首次启动」第 1 步）
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_platform

# ------------------------------------------------------------
# 【必改 ②】智谱 GLM API Key —— 全部 AI 功能的唯一开关
# 申请：https://open.bigmodel.cn/  →  控制台 → API Keys
# 改这一行即可启用：智能客服 / AI 简历诊断 / AI 模拟面试 / 商品图片识别
# 留空时：后端能正常启动，但 AI 接口会返回兜底话术
# ------------------------------------------------------------
LLM_API_KEY=
# 以下 3 项默认就是智谱，通常无需改动
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.5-flash
# 视觉模型（商品图片识别专用，需支持图片输入）
LLM_VISION_MODEL=glm-4v-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ------------------------------------------------------------
# 【必改 ③】JWT 签名密钥（本地开发可先不动，部署到公网前必须换）
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
# ------------------------------------------------------------
SECRET_KEY=CHANGE_ME_campus_platform_secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------
# 以下一般不需要改
# ------------------------------------------------------------
APP_ENV=dev
DEBUG=true

# 上传目录：写相对路径即可，程序会自动解析成 backend/uploads 的绝对路径
UPLOAD_DIR=uploads
STATIC_URL=/static
MAX_UPLOAD_SIZE_MB=10

# CORS 允许的来源，逗号分隔。生产环境请改成你的真实域名，不要用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------
# 仅当你想用本地 Ollama 替代智谱时才需要动下面这项
# 改用 Ollama 时：
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen2.5:7b
# 注意：Ollama 没有 glm-4v-flash 这类视觉模型，
#       商品图片自动识别功能会不可用，需自行换成支持图片的本地多模态模型
# ------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
