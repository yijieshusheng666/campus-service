# ============================================================
# 生产环境变量模板（阿里云服务器用）
#
# 用法：复制到 /opt/campus/backend/.env 后填写，只改标注【必改】的 3 处。
#   cp deploy/env.prod.template /opt/campus/backend/.env
#   chown campus:campus /opt/campus/backend/.env
#   chmod 600 /opt/campus/backend/.env     # 里面是明文密钥，别让其他用户读到
#
# 注意：.env 已在 .gitignore 里，不会被推上 GitHub。
# ============================================================

# ------------------------------------------------------------
# 【必改 ①】数据库连接
# DB_HOST 写 127.0.0.1 而不是 localhost：
#   走 TCP 更可预测，避免驱动尝试 unix socket 带来的路径歧义。
# DB_PASSWORD 只能用 ASCII，不能含中文 —— 含中文会在 MySQL 握手时
#   抛一句毫无线索的 latin-1 编码错误（app/config.py:63 已做前置拦截）。
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=campus
DB_PASSWORD=换成你在部署手册第二节里设的密码
DB_NAME=campus_platform

# ------------------------------------------------------------
# 【必改 ②】大模型 API Key —— 全部 AI 功能的唯一开关
# 申请：https://open.bigmodel.cn/  →  控制台 → API Keys
# 留空时：后端能正常启动，但简历诊断 / 模拟面试 / 智能客服 / 图片识别都会走兜底话术
# ------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_VISION_MODEL=glm-4v-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ------------------------------------------------------------
# 【必改 ③】JWT 签名密钥
# 生成（在服务器上跑）：
#   /opt/campus/backend/.venv/bin/python -c "import secrets;print(secrets.token_urlsafe(48))"
# 不换的风险：默认值写在 app/config.py:31 的源码里，任何人都能拿它伪造出
#   合法 token，等于所有人都是管理员。本地开发无所谓，公网必须换。
# ------------------------------------------------------------
SECRET_KEY=
# 双令牌体系：access 短命（15 分钟，泄漏损失窗口小），refresh 7 天且入库可吊销。
# ⚠️ 旧版部署的 .env 里 ACCESS_TOKEN_EXPIRE_MINUTES=10080，必须改成 15，
#    否则 .env 会覆盖 config.py 的新默认值，双令牌的「短命 access」形同虚设。
#    改完执行：systemctl restart campus-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# 运行模式
# APP_ENV 会出现在 /health 返回值里，用来确认线上跑的是哪套配置
# ------------------------------------------------------------
APP_ENV=prod
DEBUG=false

# 上传目录：写相对路径即可，app/config.py:52 会自动解析成 backend/uploads 的绝对路径
UPLOAD_DIR=uploads
STATIC_URL=/static
MAX_UPLOAD_SIZE_MB=10

# ------------------------------------------------------------
# CORS 允许来源
# 生产环境前后端是「同一个源」（都由 Nginx 的 80 端口提供，
# 前端请求 /api 走反代），浏览器根本不会触发跨域检查，
# 所以这里保持收紧即可，不要写成 *
# 把 IP 换成你的公网 IP；如果之后绑了域名，改成 http://你的域名
# ------------------------------------------------------------
CORS_ORIGINS=http://换成你的公网IP

# 未安装 Ollama，保持默认即可
OLLAMA_HOST=http://localhost:11434
