# ============================================================
# 校园综合服务平台 —— 后端 systemd 服务
# 放置路径：/etc/systemd/system/campus-api.service
#
# 启用：
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now campus-api
#   sudo systemctl status campus-api
# ============================================================

[Unit]
Description=Campus Platform API (FastAPI + uvicorn)
Documentation=https://github.com/yijieshusheng666
After=network-online.target mysql.service
Wants=network-online.target

# 不限制重启次数。systemd 默认「10 秒内失败 5 次就放弃」，会让服务停在
# start-limit-hit 状态、之后必须手动 reset-failed 才肯再启动 —— 排查 .env
# 之类的问题时会非常迷惑。设为 0 表示无限重试。
# 注意：这个键属于 [Unit] 段。写在 [Service] 段里 systemd 会直接忽略并给出
# "Unknown key name" 警告，等于没写。
StartLimitIntervalSec=0

[Service]
Type=exec
User=campus
Group=campus
WorkingDirectory=/opt/campus/backend

# 所有生产密钥都在这里（DB 密码 / JWT SECRET_KEY / LLM_API_KEY）
# 权限设成 600，且绝不进 Git
EnvironmentFile=/opt/campus/backend/.env

# ★ 只监听 127.0.0.1，不监听 0.0.0.0 ★
# 公网入口一律走 Nginx 的 80 端口。若这里监听 0.0.0.0:8001，
# 别人就能绕过 Nginx 直接打你的后端，阿里云安全组一旦漏开端口就裸奔了。
#
# ★ workers 数取决于部署模式 ★
# 单机模式（.env 里 REDIS_URL 留空）：必须 --workers 1。
# 分布式模式（.env 已配 REDIS_URL + campus-worker.service 在跑）：
#   已解决的两处进程内存状态 ——
#     1) WS 连接表：推送改走 Redis pub/sub（app/api/ws.py 的推送桥），跨 worker 可达
#     2) 简历解析任务：改投 Celery 队列（app/core/dispatch.py + app/tasks.py）
#   仍未迁移的一处 ——
#     3) 智能客服会话状态：app/agents/support_agent.py 的 _support_sessions /
#        _support_states 仍是进程内存 dict。多 worker 时用户「发布商品」多轮任务
#        可能落到不同进程，状态会丢。→ 想开多 worker，需先把这三个 dict 换成 Redis 存储。
#   所以当前仍保持 1；把第 3 项迁到 Redis 后即可调大（例如 2）。
ExecStart=/opt/campus/backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8001 --workers 1 --proxy-headers --forwarded-allow-ips='127.0.0.1'

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=campus-api

[Install]
WantedBy=multi-user.target
